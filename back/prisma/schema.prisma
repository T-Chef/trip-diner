generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin {
  admin_id Int         @id @default(autoincrement())
  username String      @db.VarChar(50)
  password String      @db.VarChar(255)
  role     admin_role? @default(manager)
}

model best30 {
  rank_id    Int       @id @default(autoincrement())
  city_id    Int?
  place_id   Int?
  rank_month DateTime? @db.Date
  city       city?     @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction, map: "best30_ibfk_1")
  place      place?    @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction, map: "best30_ibfk_2")

  @@index([city_id], map: "city_id")
  @@index([place_id], map: "place_id")
}

model category {
  category_id Int     @id @default(autoincrement())
  name        String  @db.VarChar(30)
  place       place[]
}

model city {
  city_id       Int      @id @default(autoincrement())
  city_name     String   @db.VarChar(50)
  province_name String?  @db.VarChar(50)
  description   String?  @db.Text
  best30        best30[]
  event         event[]
  place         place[]
}

model event {
  event_id    Int       @id @default(autoincrement())
  city_id     Int?
  title       String?   @db.VarChar(100)
  start_date  DateTime? @db.Date
  end_date    DateTime? @db.Date
  description String?   @db.Text
  image_url   String?   @db.VarChar(255)
  city        city?     @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction, map: "event_ibfk_1")

  @@index([city_id], map: "city_id")
}

model place {
  place_id    Int       @id @default(autoincrement())
  city_id     Int?
  category_id Int?
  name        String    @db.VarChar(100)
  address     String?   @db.VarChar(255)
  latitude    Decimal?  @db.Decimal(10, 6)
  longitude   Decimal?  @db.Decimal(10, 6)
  description String?   @db.Text
  image_url   String?   @db.VarChar(255)
  rating      Decimal?  @db.Decimal(2, 1)
  best30      best30[]
  city        city?     @relation(fields: [city_id], references: [city_id], onDelete: NoAction, onUpdate: NoAction, map: "place_ibfk_1")
  category    category? @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "place_ibfk_2")
  review      review[]
  trip        trip[]

  @@index([category_id], map: "category_id")
  @@index([city_id], map: "city_id")
}

model review {
  review_id  Int       @id @default(autoincrement())
  user_id    Int?
  place_id   Int?
  rating     Decimal?  @db.Decimal(2, 1)
  content    String?   @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
  users      users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "review_ibfk_1")
  place      place?    @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction, map: "review_ibfk_2")

  @@index([place_id], map: "place_id")
  @@index([user_id], map: "user_id")
}

model trip {
  trip_id      Int       @id @default(autoincrement())
  user_id      Int
  title        String    @db.VarChar(100)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  day          Int
  order_no     Int
  place_id     Int?
  place_name   String?   @db.VarChar(100)
  activity     String?   @db.VarChar(255)
  time_slot    String?   @db.VarChar(20)
  latitude     Decimal?  @db.Decimal(10, 6)
  longitude    Decimal?  @db.Decimal(10, 6)
  keyword_tags String?   @db.VarChar(255)
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "trip_ibfk_1")
  place        place?    @relation(fields: [place_id], references: [place_id], onDelete: NoAction, onUpdate: NoAction, map: "trip_ibfk_2")

  @@index([place_id], map: "place_id")
  @@index([user_id], map: "user_id")
}

model users {
  user_id   Int       @id @default(autoincrement())
  username  String    @db.VarChar(50)
  email     String    @unique(map: "email") @db.VarChar(100)
  password  String    @db.VarChar(255)
  join_date DateTime? @default(now()) @db.DateTime(0)
  review    review[]
  trip      trip[]
}

enum admin_role {
  super
  manager
}
