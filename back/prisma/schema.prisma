generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
/* -------------------------------------------------------
   ADMIN
------------------------------------------------------- */
model admin {
  admin_id     BigInt      @id @default(autoincrement())
  email        String      @unique @db.VarChar(255)
  password     String      @db.VarChar(255)
  name         String?     @db.VarChar(100)
  profile_img  String?     @db.VarChar(255)
  role         admin_role  @default(SUPER)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  last_login   DateTime?
  qna_answers  qna_answer[]
}
/* -------------------------------------------------------
   CITY
------------------------------------------------------- */
model city {
  city_id     BigInt     @id @default(autoincrement())
  name        String      @db.VarChar(100)
  country     String?     @db.VarChar(100)
  description String?     @db.Text
  image_url   String?     @db.VarChar(500)
  event       event[]
  place       place[]
  plan        plan[]
  weather     weather[]
}
/* -------------------------------------------------------
   EVENT
------------------------------------------------------- */
model event {
  event_id    BigInt     @id @default(autoincrement())
  city_id     BigInt
  title       String?    @db.VarChar(255)
  description String?    @db.Text
  start_date  DateTime?  @db.Date
  end_date    DateTime?  @db.Date
  city        city       @relation(fields: [city_id], references: [city_id])
  @@index([city_id])
}
/* -------------------------------------------------------
   PLACE
------------------------------------------------------- */
model place {
  place_id     BigInt       @id @default(autoincrement())
  external_id  BigInt?      @unique
  city_id      BigInt?
  name         String?      @db.VarChar(255)
  category     String?      @db.VarChar(255)
  address      String?      @db.VarChar(500)
  lat          Float?
  lng          Float?
  description  String?      @db.Text
  image_url    String?      @db.VarChar(2000)
  city         city?        @relation(fields: [city_id], references: [city_id])
  place_like   place_like[]
  plan_item    plan_item[]
  review_place review_place[]
  @@index([city_id])
}
/* -------------------------------------------------------
   AI HISTORY & KEYWORD
------------------------------------------------------- */
model ai_history {
  ai_id      BigInt      @id @default(autoincrement())
  user_id    BigInt?
  keyword_id BigInt?
  plan_id    BigInt?
  created_at DateTime?   @default(now()) @db.DateTime(0)
  user       user?       @relation(fields: [user_id], references: [user_id])
  ai_keyword ai_keyword? @relation(fields: [keyword_id], references: [keyword_id])
  plan       plan?       @relation(fields: [plan_id], references: [plan_id])
  @@index([user_id])
  @@index([keyword_id])
  @@index([plan_id])
}
model ai_keyword {
  keyword_id  BigInt       @id @default(autoincrement())
  keyword     String?      @db.VarChar(100)
  description String?      @db.VarChar(255)
  ai_history  ai_history[]
}
/* -------------------------------------------------------
   COMMENT (댓글)
------------------------------------------------------- */
model comment {
  comment_id    BigInt     @id @default(autoincrement())
  post_id       BigInt
  user_id       BigInt
  parent_id     BigInt?
  content       String?    @db.Text
  created_at    DateTime?  @default(now()) @db.DateTime(0)
  post          post       @relation(fields: [post_id], references: [post_id])
  user          user       @relation(fields: [user_id], references: [user_id])
  comment       comment?   @relation("commentTocomment", fields: [parent_id], references: [comment_id])
  other_comment comment[]  @relation("commentTocomment")
  @@index([post_id])
  @@index([user_id])
  @@index([parent_id])
}
/* -------------------------------------------------------
   PLAN / PLAN DAY / PLAN ITEM
------------------------------------------------------- */
model plan {
  plan_id    BigInt       @id @default(autoincrement())
  user_id    BigInt
  city_id    BigInt?
  title      String?      @db.VarChar(255)
  start_date DateTime?    @db.Date
  end_date   DateTime?    @db.Date
  memo       String?      @db.Text
  created_at DateTime?    @default(now()) @db.DateTime(0)
  shared_url String?      @db.VarChar(500)
  ai_history ai_history[]
  user       user         @relation(fields: [user_id], references: [user_id])
  city       city?        @relation(fields: [city_id], references: [city_id])
  plan_day   plan_day[]
  @@index([user_id])
  @@index([city_id])
}
model plan_day {
  plan_day_id BigInt      @id @default(autoincrement())
  plan_id     BigInt
  day_index   Int
  date        DateTime?   @db.Date
  plan        plan        @relation(fields: [plan_id], references: [plan_id])
  plan_item   plan_item[]
  @@index([plan_id])
}
model plan_item {
  plan_item_id BigInt   @id @default(autoincrement())
  plan_day_id  BigInt
  place_id     BigInt?
  order_index  Int?
  memo         String?  @db.VarChar(255)
  time         String?  @db.VarChar(100)
  plan_day     plan_day @relation(fields: [plan_day_id], references: [plan_day_id])
  place        place?   @relation(fields: [place_id], references: [place_id])
  @@index([plan_day_id])
  @@index([place_id])
}
/* -------------------------------------------------------
   POST
------------------------------------------------------- */
model post {
  post_id    BigInt      @id @default(autoincrement())
  user_id    BigInt
  title      String?     @db.VarChar(255)
  content    String?     @db.Text
  image_url  String?     @db.VarChar(500)
  created_at DateTime?   @default(now()) @db.DateTime(0)
  updated_at DateTime?   @default(now()) @db.DateTime(0)
  comment    comment[]
  user       user        @relation(fields: [user_id], references: [user_id])
  post_like  post_like[]
  report     report[]
  @@index([user_id])
}
/* -------------------------------------------------------
   QNA & ANSWER
------------------------------------------------------- */
model qna {
  qna_id     BigInt       @id @default(autoincrement())
  user_id    BigInt
  title      String?      @db.VarChar(255)
  content    String?      @db.Text
  created_at DateTime?    @default(now()) @db.DateTime(0)
  status     qna_status   @default(WAITING)
  user       user         @relation(fields: [user_id], references: [user_id])
  qna_answer qna_answer[]
  @@index([user_id])
}
model qna_answer {
  answer_id  BigInt     @id @default(autoincrement())
  qna_id     BigInt
  admin_id   BigInt
  content    String?    @db.Text
  created_at DateTime?  @default(now()) @db.DateTime(0)
  qna        qna        @relation(fields: [qna_id], references: [qna_id])
  admin      admin      @relation(fields: [admin_id], references: [admin_id])
  @@index([qna_id])
  @@index([admin_id])
}
/* -------------------------------------------------------
   REPORT
------------------------------------------------------- */
model report {
  report_id  BigInt     @id @default(autoincrement())
  post_id    BigInt
  user_id    BigInt
  content    String?    @db.VarChar(500)
  created_at DateTime?  @default(now()) @db.DateTime(0)
  post       post       @relation(fields: [post_id], references: [post_id])
  user       user       @relation(fields: [user_id], references: [user_id])
  @@index([post_id])
  @@index([user_id])
}
/* -------------------------------------------------------
   REVIEW PLACE
------------------------------------------------------- */
model review_place {
  review_id  BigInt     @id @default(autoincrement())
  place_id   BigInt
  user_id    BigInt
  rating     Int?
  content    String?    @db.Text
  created_at DateTime?  @default(now()) @db.DateTime(0)
  place      place      @relation(fields: [place_id], references: [place_id])
  user       user       @relation(fields: [user_id], references: [user_id])
  @@index([place_id])
  @@index([user_id])
}
/* -------------------------------------------------------
   USER  (provider → String)
------------------------------------------------------- */
model user {
  user_id      BigInt      @id @default(autoincrement())
  email        String       @unique @db.VarChar(255)
  password     String       @db.VarChar(255)
  name         String?      @db.VarChar(100)
  profile_img  String?      @db.VarChar(500)
  provider     String       @default("LOCAL") @db.VarChar(50)
  created_at   DateTime?    @default(now()) @db.DateTime(0)
  deleted      Int?         @default(0)
  ai_history   ai_history[]
  comment      comment[]
  place_like   place_like[]
  plan         plan[]
  post         post[]
  post_like    post_like[]
  qna          qna[]
  report       report[]
  review_place review_place[]
}
/* -------------------------------------------------------
   WEATHER
------------------------------------------------------- */
model weather {
  weather_id  BigInt     @id @default(autoincrement())
  city_id     BigInt
  date        DateTime?  @db.Date
  temperature Float?
  status      String?    @db.VarChar(100)
  humidity    Int?
  city        city       @relation(fields: [city_id], references: [city_id])
  @@index([city_id])
}
/* -------------------------------------------------------
   PLACE LIKE / POST LIKE
------------------------------------------------------- */
model place_like {
  like_id    BigInt     @id @default(autoincrement())
  user_id    BigInt
  place_id   BigInt
  created_at DateTime?  @default(now()) @db.DateTime(0)

  place      place      @relation(fields: [place_id], references: [place_id], onDelete: Cascade)
  user       user       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, place_id])
  @@index([place_id])
  @@index([user_id])
}
model post_like {
  like_id    BigInt     @id @default(autoincrement())
  user_id    BigInt
  post_id    BigInt
  created_at DateTime?  @default(now()) @db.DateTime(0)
  post       post       @relation(fields: [post_id], references: [post_id], onDelete: Cascade)
  user       user       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  @@index([post_id])
  @@index([user_id])
}
/* -------------------------------------------------------
   ENUMS
------------------------------------------------------- */
enum admin_role {
  SUPER
}
enum admin_status {
  ACTIVE
  DISABLED
}
enum qna_status {
  WAITING
  DONE
}